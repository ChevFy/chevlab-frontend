# Copy to .env.local for development:  cp .env.example .env.local
# In production set these in wrangler.jsonc vars (or the Cloudflare dashboard).
# Both are server-side only — never sent to the browser.

# Where the /api/* proxy forwards to (src/app/api/[...path]/route.ts).
# Point this at your own chevlab-backend:
#   - running it locally:        http://localhost:8000   (FastAPI default port)
#   - backend on another host:   https://your-backend.example.com
#   - behind a Cloudflare Tunnel: https://your-tunnel-hostname
BACKEND_URL=http://localhost:8000

# Shared secret sent as the `x-chevlab-proxy` header.
# Only needed when the backend sits behind a Cloudflare WAF that would otherwise
# block the frontend worker: generate one with `openssl rand -hex 24` and put the
# SAME value in the backend's WAF allow rule.
# Leave blank for a local or unprotected backend.
BACKEND_PROXY_SECRET=
