{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chevlab-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    // Backend origin the /api/* proxy forwards to. Trailing slash is stripped.
    "BACKEND_URL": "https://chevlab.chevfy.com",
    // Shared secret the proxy sends as `x-chevlab-proxy`; the backend's Cloudflare
    // WAF allows worker→tunnel requests carrying it. If this repo is public, move
    // it out with `wrangler secret put BACKEND_PROXY_SECRET` and delete this line.
    "BACKEND_PROXY_SECRET": "cl_e3bf649d4be78bf1dc41a109a0f0cc45c56dc916f58b7cd3"
  }
}
