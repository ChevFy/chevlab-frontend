{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chevlab-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    // Backend origin the /api/* proxy forwards to. Trailing slash is stripped.
    "BACKEND_URL": "https://chevlab.chevfy.com"
    // BACKEND_PROXY_SECRET is NOT stored here — it's a secret, set out-of-band:
    //   npx wrangler secret put BACKEND_PROXY_SECRET
    // (keeps it out of git; the value must match the backend's WAF allow rule)
  }
}
